{
  "node_name": "TotalSegmentator",
  "display_name": "TotalSegmentator (Organ/Tissue)",
  "category": "TissueSeg",
  "h5_group": "TotalSegmentator",
  "description": "Automatic segmentation of 104+ anatomical structures in CT and MR images",
  "version": "2.0.0",
  "runtime": {
    "env_name": "totalsegmentator_tissuelab",
    "service_path": "E:\\Tissuelab-Model-Zoo\\tissue_segmentation\\TotalSegmentator\\totalsegmentator_tasknode.py",
    "python_version": "3.9",
    "port": 8010
  },
  "parameters": {
    "path": {
      "type": "string",
      "required": true,
      "description": "Input medical image path (NIfTI or DICOM)",
      "example": "/path/to/ct_scan.nii.gz"
    },
    "task": {
      "type": "string",
      "required": false,
      "default": "total",
      "options": [
        "total",
        "body",
        "lung_vessels",
        "cerebral_bleed",
        "hip_implant",
        "coronary_arteries",
        "pleural_pericard_effusion"
      ],
      "description": "Segmentation task type"
    },
    "fast": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Use fast mode (faster but slightly lower quality)"
    },
    "ml": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Use multilabel format"
    },
    "roi_subset": {
      "type": "string",
      "required": false,
      "default": null,
      "description": "Comma-separated list of specific ROIs to segment (e.g., 'liver,spleen,kidney_right')",
      "example": "liver,spleen,kidney_right,kidney_left"
    }
  },
  "inputs": {
    "type": "Medical image",
    "format": ["NIfTI", "DICOM"],
    "modality": ["CT", "MRI"],
    "description": "3D medical imaging data"
  },
  "outputs": {
    "masks": {
      "type": "ndarray",
      "shape": "[N, H, W, D]",
      "description": "Segmentation masks for each anatomical structure"
    },
    "roi_names": {
      "type": "list of strings",
      "description": "Names of segmented anatomical structures"
    }
  },
  "dependencies": {
    "python": ">=3.9",
    "packages": [
      "TotalSegmentator>=2.0.0",
      "nibabel>=5.0.0",
      "torch>=2.0.0"
    ],
    "optional": {
      "gpu": "NVIDIA GPU with CUDA support (recommended for performance)"
    }
  },
  "performance": {
    "fast_mode": {
      "speed_improvement": "3-5x faster",
      "accuracy_impact": "Slightly lower (~2-5% IoU decrease)"
    },
    "typical_runtime": {
      "cpu": "10-30 minutes per CT scan",
      "gpu": "2-5 minutes per CT scan (with fast mode: <1 minute)"
    }
  },
  "use_cases": [
    "Organ volume measurements",
    "Radiotherapy planning",
    "Surgical planning",
    "Disease progression tracking",
    "Body composition analysis",
    "Vascular analysis"
  ]
}
