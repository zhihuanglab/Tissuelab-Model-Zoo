@app.function(
    image=image.env({
        "STARDIST_CACHE_DIR": MODEL_CACHE_PATH,
        "PYTHONPATH": "/root"
    }),
    cpu=4,
    memory=32768,
    retries=1,
    volumes={MODEL_CACHE_PATH: model_cache},
    timeout=1800,
)
def process_from_url(
    image_url: str,
    stardist_pretrain: str = "2D_versatile_he",
    isIHC: bool = False,
    tile_size: int = 4096,
    overlap: int = 256,
    prob_thresh: float = 0.3,
    nms_thresh: float = 0.3,
    magnification: int = 40,
    with_embedding: bool = False
) -> dict:
    """
    Simplified function to process an image directly from URL
    
    Args:
        image_url: URL to the image file
        stardist_pretrain: StarDist model name
        isIHC: Whether the image is IHC stained
        tile_size: Tile size for processing
        overlap: Overlap between tiles
        prob_thresh: Probability threshold
        nms_thresh: NMS threshold
        magnification: Image magnification
    
    Returns:
        Segmentation results dictionary
    """
    patch_data = {
        'patch_id': 'url_image',
        'image_url': image_url,
        'stardist_pretrain': stardist_pretrain,
        'isIHC': isIHC,
        'tile_size': tile_size,
        'overlap': overlap,
        'prob_thresh': prob_thresh,
        'nms_thresh': nms_thresh,
        'magnification': magnification,
        'position': (0, 0),
        'scale': 1.0,
        'keep_temp': with_embedding
    }
    
    seg_result = process_segmentation.local(patch_data)
    
    if with_embedding and seg_result.get('status') == 'success':
        slide_path = seg_result.get('tmp_path', '')
        emb_payload = {
            'patch_id': seg_result.get('patch_id', 'url_image'),
            'patch_index': seg_result.get('patch_index'),
            'centroids': seg_result.get('centroids', []),
            'slide_path': slide_path,
            'magnification': magnification,
            'read_image_method': 'tiffslide',
        }
        emb_result = process_embedding.local(emb_payload)
        seg_result['embedding'] = emb_result
        # Cleanup the kept temp file after embeddings
        if slide_path and os.path.exists(slide_path):
            try:
                os.unlink(slide_path)
            except Exception:
                pass
    
    return seg_result

@app.local_entrypoint()
def test_with_url():
    """Test function to process Google Storage URL"""
    # Prefer env var if provided; otherwise parse from local test_url.py (fallback to /root/ in container)
    google_storage_url = os.environ.get("GOOGLE_STORAGE_URL", "")
    if not google_storage_url:
        try:
            import re
            content = None
            # Try local repo path first (works for local_entrypoint on host)
            local_dir = os.path.dirname(__file__)
            local_test_file = os.path.join(local_dir, "test_url.py")
            if os.path.exists(local_test_file):
                with open(local_test_file, "r", encoding="utf-8") as f:
                    content = f.read()
            else:
                # Fallback to container-baked path
                container_test_file = "/root/test_url.py"
                if os.path.exists(container_test_file):
                    with open(container_test_file, "r", encoding="utf-8") as f:
                        content = f.read()
            if not content:
                print("test_url.py not found locally or in /root/")
                return {"status": "error", "message": "test_url.py not found"}
            m = re.search(r'GOOGLE_STORAGE_URL\s*=\s*"([^"]+)"', content)
            if m:
                google_storage_url = m.group(1)
            else:
                print("Failed to parse GOOGLE_STORAGE_URL from test_url.py")
                return {"status": "error", "message": "GOOGLE_STORAGE_URL not found in test_url.py"}
        except Exception as e:
            print(f"Error reading test_url.py: {e}")
            return {"status": "error", "message": str(e)}
    
    print("="*70)
    print("Testing StarDist Modal with Google Storage URL")
    print("="*70)
    print()
    
    result = process_from_url.remote(
        image_url=google_storage_url,
        stardist_pretrain="2D_versatile_he",
        magnification=40,
        with_embedding=True
    )
    
    print("="*70)
    if result['status'] == 'success':
        print("✅ Success!")
        print(f"  Nuclei: {result['nuclei_count']:,}")
        print(f"  Time: {result['timing']['total']:.2f}s")
    else:
        print("❌ Failed!")
        print(f"  Error: {result.get('message')}")
    print("="*70)
    
    return result

